# Local development only. In production these are injected by Cloud Run.
# Copy this file to `.env` and fill in real values.

# GCP project hosting Firestore, GCS, and Cloud Run
GCP_PROJECT_ID=loop-pla-prod-intranet

# Firestore named database (non-default)
FIRESTORE_DATABASE_ID=loop-kaybee-prod

# Private GCS bucket for content-addressed image assets
GCS_BUCKET=loop-kaybee-prod-assets

# Root Google Drive folder ID to sync from
ROOT_FOLDER_ID=

# Shared secret validating inbound n8n POST /sync/:docId requests
SYNC_SECRET=

# Path to a downloaded service-account key. Local dev only — not used on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
